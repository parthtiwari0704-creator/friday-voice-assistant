# Copy to .env and fill in. Only an LLM key is required; everything else has defaults.

# --- Brain -------------------------------------------------------------------------
FRIDAY_PROVIDER=anthropic                  # anthropic | openai (any OpenAI-compatible API)
FRIDAY_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Free & local brain via Ollama:  FRIDAY_PROVIDER=openai  FRIDAY_MODEL=llama3.1  OPENAI_BASE_URL=http://localhost:11434/v1

# --- You ---------------------------------------------------------------------------
FRIDAY_USER_NAME=Parth
FRIDAY_TIMEZONE=Asia/Kolkata
FRIDAY_CITY=Pune

# --- Voice (what FRIDAY sounds like) --------------------------------------------------
FRIDAY_TTS_ENGINE=auto                     # auto | piper | system | openai | none
FRIDAY_VOICE=female                        # female | male | female-uk | male-uk | female-2 | male-2 (or any Piper voice id)
FRIDAY_SPEAKING_RATE=1.0                   # 0.5 – 2.0
# FRIDAY_OPENAI_TTS_MODEL=tts-1            # for FRIDAY_TTS_ENGINE=openai (or a Kokoro server via OPENAI_BASE_URL)

# --- Ears (speech recognition) ----------------------------------------------------------
FRIDAY_STT_ENGINE=auto                     # auto | whisper | openai
FRIDAY_WHISPER_MODEL=base.en               # tiny.en (fastest) · base.en · small.en (most accurate)
FRIDAY_WAKE_WORDS=friday,hey friday,ok friday
FRIDAY_FOLLOW_UP_SECONDS=6                 # after answering, keep listening this long without the wake word

# --- Integrations ------------------------------------------------------------------------
# Give FRIDAY Jarvis's Gmail/Calendar tools over MCP (install Jarvis with its [mcp] extra first):
# FRIDAY_JARVIS_MCP_COMMAND=jarvis mcp
# Apps FRIDAY may open (nothing else can be launched). Windows example:
# FRIDAY_APPS={"notepad": "notepad.exe", "calculator": "calc.exe", "spotify": "spotify:"}
# macOS example: FRIDAY_APPS={"spotify": "Spotify", "notes": "Notes"}

# --- Server -------------------------------------------------------------------------------
FRIDAY_API_TOKEN=                          # required if the HUD is reachable from other devices
